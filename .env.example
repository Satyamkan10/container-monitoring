# Copy to .env and fill in:   cp .env.example .env
# .env is git-ignored — never commit real secrets.
# Wrap values containing $ or spaces in single quotes, e.g. GF_SMTP_PASSWORD='pa$$word'

# --- Grafana ---
GF_PORT=3001
GF_ADMIN_USER=admin
# Only applied on FIRST start (fresh grafana_data volume). To change later, see README.
GF_ADMIN_PASSWORD=change-me-to-something-strong

# --- SMTP (alert emails) ---
# 465 = implicit TLS, 587 = STARTTLS (preferred). Gmail/O365 need an app password.
GF_SMTP_ENABLED=true
GF_SMTP_HOST=smtp.example.com:587
GF_SMTP_USER=alerts@example.com
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=alerts@example.com
# true = accept self-signed/internal certs; set false for public CAs
GF_SMTP_SKIP_VERIFY=true

# --- Alert recipients (semicolon-separated) ---
GF_ALERT_TO=ops@example.com

# --- Netdata ---
NETDATA_HOSTNAME=my-server
